# =========================================================================
# DATABASE CONFIGURATION
# =========================================================================
# Dapatkan ini dari Dashboard Supabase Anda:
# Klik tombol hijau "Connect" di bagian atas -> "ORMs" -> Copy "Connection string"
# Pastikan Anda mengganti [YOUR-PASSWORD] dengan password database Anda.
# Contoh format:
# DATABASE_URI=postgresql://postgres.ahjpvkzpyxfhbuhwbfqb:[PASSWORD_ANDA]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
DATABASE_URI=

# =========================================================================
# PAYLOAD CMS SECRETS
# =========================================================================
# String rahasia acak untuk enkripsi JWT/sesi Payload.
# Anda bisa mengisinya dengan kombinasi huruf/angka acak yang panjang.
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Melindungi endpoint operasional dan runner recovery. Gunakan nilai acak
# yang berbeda dari PAYLOAD_SECRET dan simpan hanya di environment server.
ADMIN_API_SECRET=replace-with-a-different-random-secret
CRON_SECRET=replace-with-a-random-secret-at-least-16-characters

# =========================================================================
# APP URL
# =========================================================================
# Base URL aplikasi saat ini (untuk development gunakan localhost)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# =========================================================================
# AUTOMATIC TRANSLATION (ID -> EN)
# =========================================================================
GEMINI_API_KEY=
GEMINI_TRANSLATION_MODEL=gemini-3.6-flash

# Opsional. JSON satu baris untuk istilah yang wajib konsisten.
# Contoh: {"Badan Kepegawaian Negara":"National Civil Service Agency"}
TRANSLATION_GLOSSARY_JSON={}
